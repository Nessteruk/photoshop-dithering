{
  "manifestVersion": 5,
  "id": "io.github.nessteruk.dithering",
  "name": "Dithering",
  "version": "1.0.0",
  "main": "index.html",
  "featureFlags": {
    "enableSWCSupport": true
  },
  "host": {
    "app": "PS",
    "minVersion": "26.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "dithering",
      "label": {
        "default": "Dithering"
      },
      "minimumSize": {
        "width": 230,
        "height": 200
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 500
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 600
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/plugin-onDark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/plugin-onLight.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/plugin-onDark.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/plugin-onLight.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
